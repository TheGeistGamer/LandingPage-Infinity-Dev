---
import {
	NavBar,
	Hero,
	LandingInteractions,
	CTA,
	Faq,
	Footer,
	Process,
	Services,
	Stats,
	Work,
} from "../components";
import { faqs } from "../data/faq";
import Layout from "../layouts/Layout.astro";

const faqJsonLd = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	inLanguage: "es-MX",
	mainEntity: faqs.map((item) => ({
		"@type": "Question",
		name: item.q.es,
		acceptedAnswer: { "@type": "Answer", text: item.a.es },
	})),
};
---

<Layout jsonLd={[faqJsonLd]}>
	<NavBar />

	<main id="main">
		<a id="top"></a>

		<Hero />
		<Stats />
		<Services />
		<Process />

		<!-- Hidrata solo lo que tiene estado: el modal de proyectos -->
		<Work client:load />

		<Faq />
		<CTA />
	</main>

	<Footer />

	<LandingInteractions client:load />
</Layout>
