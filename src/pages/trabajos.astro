---
import { AllWork, CTA, Footer, LandingInteractions, NavBar } from "../components";
import { products, kindLabels } from "../data/products";
import Layout from "../layouts/Layout.astro";

const site = Astro.site ?? new URL("https://infinitydev.agency");
const pageUrl = new URL("/trabajos", site).toString();

const collectionJsonLd = {
	"@context": "https://schema.org",
	"@type": "CollectionPage",
	"@id": `${pageUrl}#page`,
	url: pageUrl,
	name: "Todos los trabajos de Infinity Dev",
	inLanguage: "es-MX",
	isPartOf: { "@id": new URL("/#website", site).toString() },
	mainEntity: {
		"@type": "ItemList",
		numberOfItems: products.length,
		itemListElement: products.map((product, index) => ({
			"@type": "ListItem",
			position: index + 1,
			item: {
				"@type": "CreativeWork",
				name: product.name.es,
				description: product.summary.es,
				genre: kindLabels[product.kind].es,
				creator: { "@id": new URL("/#organization", site).toString() },
				...(product.link ? { url: product.link.href } : {}),
			},
		})),
	},
};

const breadcrumbJsonLd = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	itemListElement: [
		{ "@type": "ListItem", position: 1, name: "Inicio", item: site.toString() },
		{ "@type": "ListItem", position: 2, name: "Todos los trabajos", item: pageUrl },
	],
};
---

<Layout
	title="Todos los trabajos | Apps, sitios web y dashboards - Infinity Dev"
	description="Apps móviles, sitios web y paneles de administración que Infinity Dev ha diseñado y construido, listados uno por uno con capturas y detalles."
	canonical="/trabajos"
	jsonLd={[collectionJsonLd, breadcrumbJsonLd]}
>
	<NavBar />

	<main id="main">
		<AllWork client:load />
		<CTA />
	</main>

	<Footer />

	<LandingInteractions client:load />
</Layout>
