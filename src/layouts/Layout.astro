---
import '../theme/global.css'

interface Props {
	title?: string;
	description?: string;
	canonical?: string;
	image?: string;
	imageAlt?: string;
	type?: 'website' | 'article';
	noindex?: boolean;
	/** Datos estructurados extra de la página (se suman a Organization y WebSite) */
	jsonLd?: Record<string, unknown>[];
	/** Idioma de la página: el español vive en la raíz y el inglés en /en */
	lang?: 'es' | 'en';
	/** Ruta equivalente en cada idioma, para <link rel="alternate" hreflang> */
	alternates?: { es: string; en: string };
}

const SITE_NAME = 'Infinity Dev';
const EMAIL = 'contacto@infinitydev.agency';

const copy = {
	es: {
		title: 'Infinity Dev | Desarrollo de software a medida, apps y dashboards',
		description:
			'Diseñamos y desarrollamos apps web y móviles, servidores y dashboards a la medida de tu negocio. Sin plantillas: producto propio, de la idea al lanzamiento.',
		imageAlt: 'Infinity Dev: software único, hecho para tu historia',
		skip: 'Saltar al contenido',
		locale: 'es_MX',
		otherLocale: 'en_US',
	},
	en: {
		title: 'Infinity Dev | Custom software development, apps and dashboards',
		description:
			'We design and build web and mobile apps, servers and dashboards tailored to your business. No templates: a product of your own, from idea to launch.',
		imageAlt: 'Infinity Dev: unique software, built for your story',
		skip: 'Skip to content',
		locale: 'en_US',
		otherLocale: 'es_MX',
	},
};

const {
	lang = 'es',
	alternates,
	title = copy[lang].title,
	description = copy[lang].description,
	canonical,
	image = '/og-image.jpg',
	imageAlt = copy[lang].imageAlt,
	type = 'website',
	noindex = false,
	jsonLd = [],
} = Astro.props;

const siteUrl = Astro.site ?? new URL('https://infinitydev.agency');
const canonicalUrl = new URL(canonical ?? Astro.url.pathname, siteUrl);
const imageUrl = new URL(image, siteUrl);
const isDefaultImage = image === '/og-image.jpg';

const alternateUrls = alternates
	? { es: new URL(alternates.es, siteUrl).toString(), en: new URL(alternates.en, siteUrl).toString() }
	: undefined;

const organizationId = new URL('/#organization', siteUrl).toString();

const baseJsonLd = [
	{
		'@context': 'https://schema.org',
		'@type': 'Organization',
		'@id': organizationId,
		name: SITE_NAME,
		url: siteUrl.toString(),
		logo: new URL('/logo_basic.webp', siteUrl).toString(),
		image: new URL('/og-image.jpg', siteUrl).toString(),
		description,
		email: EMAIL,
		contactPoint: [
			{
				'@type': 'ContactPoint',
				contactType: 'sales',
				email: EMAIL,
				availableLanguage: ['es', 'en'],
			},
		],
		knowsAbout: [
			'Desarrollo de software a medida',
			'Aplicaciones web',
			'Aplicaciones móviles',
			'Servidores y APIs',
			'Dashboards empresariales',
		],
	},
	{
		'@context': 'https://schema.org',
		'@type': 'WebSite',
		'@id': new URL('/#website', siteUrl).toString(),
		url: siteUrl.toString(),
		name: SITE_NAME,
		inLanguage: ['es-MX', 'en'],
		publisher: { '@id': organizationId },
	},
];

const structuredData = [...baseJsonLd, ...jsonLd];
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />

		<title>{title}</title>
		<meta name="description" content={description} />
		<meta
			name="robots"
			content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
		/>
		<meta name="author" content={SITE_NAME} />
		<meta name="publisher" content={SITE_NAME} />
		<meta name="theme-color" content="#ffffff" />
		<meta name="color-scheme" content="light" />
		<meta name="format-detection" content="telephone=no" />

		<link rel="canonical" href={canonicalUrl.toString()} />
		{alternateUrls && <link rel="alternate" hreflang="es" href={alternateUrls.es} />}
		{alternateUrls && <link rel="alternate" hreflang="en" href={alternateUrls.en} />}
		{alternateUrls && <link rel="alternate" hreflang="x-default" href={alternateUrls.es} />}
		<link rel="sitemap" type="application/xml" href="/sitemap.xml" />
		<link rel="icon" type="image/svg+xml" href="/logo-basic.svg" />
		<link rel="apple-touch-icon" href="/logo_basic.webp" />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap"
		/>

		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content={type} />
		<meta property="og:url" content={canonicalUrl.toString()} />
		<meta property="og:image" content={imageUrl.toString()} />
		{isDefaultImage && <meta property="og:image:width" content="1200" />}
		{isDefaultImage && <meta property="og:image:height" content="630" />}
		{isDefaultImage && <meta property="og:image:type" content="image/jpeg" />}
		<meta property="og:image:alt" content={imageAlt} />
		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:locale" content={copy[lang].locale} />
		<meta property="og:locale:alternate" content={copy[lang].otherLocale} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imageUrl.toString()} />
		<meta name="twitter:image:alt" content={imageAlt} />

		{structuredData.map((entry) => <script type="application/ld+json" set:html={JSON.stringify(entry)} />)}

		<noscript>
			<style>
				.reveal {
					opacity: 1 !important;
					transform: none !important;
				}
			</style>
		</noscript>
	</head>
	<body class={lang === 'en' ? 'en' : undefined}>
		<a href="#main" class="skip-link">{copy[lang].skip}</a>
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}

	.skip-link {
		position: fixed;
		top: 8px;
		left: 8px;
		z-index: 300;
		padding: 10px 16px;
		border-radius: 12px;
		background: #171b24;
		color: #fff;
		font-weight: 700;
		transform: translateY(-200%);
		transition: transform 0.2s;
	}

	.skip-link:focus {
		transform: none;
	}
</style>
