{
	"compatibility_date": "2026-06-14",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "landing-page-infinity-dev",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"routes": [
		{ "pattern": "infinitydev.agency", "custom_domain": true },
		{ "pattern": "www.infinitydev.agency", "custom_domain": true }
	],
	"observability": {
		"enabled": true
	}
}